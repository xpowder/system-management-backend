# Copy this file to .env in the project root and fill in values.

# --- Local gym PC / development ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-change-this-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:8000,http://127.0.0.1:5173
DJANGO_HTTPS=False
DJANGO_LISTEN=127.0.0.1:8000

# --- Production (public internet or locked-down gym PC) ---
# DJANGO_DEBUG=False
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=paste-a-long-random-value-here
# DJANGO_ALLOWED_HOSTS=your-domain.com,127.0.0.1
# DJANGO_CORS_ORIGINS=https://your-domain.com
# DJANGO_HTTPS=True
# DJANGO_LISTEN=127.0.0.1:8000

# --- PostgreSQL (Railway) ---
# Local PC: leave DATABASE_URL and PGHOST empty to keep db.sqlite3.
# This PC talking to Railway Postgres: paste DATABASE_PUBLIC_URL into DATABASE_URL.
# Railway Django service: DATABASE_URL=${{Postgres.DATABASE_URL}}
#   (or ${{Postgres.DATABASE_PRIVATE_URL}} on the private network)
DATABASE_URL=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432

# --- Railway Django service (do NOT paste this PC's .env) ---
# DJANGO_DEBUG=False
# DJANGO_HTTPS=True
# DJANGO_SECRET_KEY=paste-a-long-random-value-here
# DJANGO_FRONTEND_ORIGIN=https://system-management-production-5616.up.railway.app
# DJANGO_CORS_ORIGINS=https://system-management-production-5616.up.railway.app
# DJANGO_ALLOWED_HOSTS=system-management-production-5616.up.railway.app
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave PORT and DJANGO_LISTEN unset. Railway sets PORT.
# Superuser in the Railway Docker container (Shell / one-off):
#   python manage.py createsuperuser
# Local Docker: docker compose --profile tools run --rm superuser

# --- Docker (backend + frontend + Postgres) ---
# docker compose up --build
# App: http://localhost:8080   API: http://localhost:8000
# Compose uses its own Postgres container, not Railway.
